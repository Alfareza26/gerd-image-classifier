# ==========================================
# Root .gitignore for GERD Classification
# Covers both Frontend and Backend
# ==========================================

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDE & Editor Files ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Archives & Temporary Zips ---
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
*.env.local

# --- Log Files ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# FRONTEND (React + Vite + Node.js)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/coverage/
frontend/.next/
frontend/out/
frontend/.cache/
frontend/.parcel-cache/
frontend/.turbo/
frontend/*.tsbuildinfo
frontend/.eslintcache
frontend/.stylelintcache

# Generic Node artifacts
node_modules/
dist/

# ==========================================
# BACKEND (Python + FastAPI + TensorFlow)
# ==========================================
# Virtual Environments
backend/.venv/
backend/venv/
backend/env/
backend/ENV/
.venv/
venv/
env/

# Python Bytecode & Cache
backend/**/__pycache__/
backend/**/.pytest_cache/
backend/**/.mypy_cache/
backend/**/.ruff_cache/
backend/**/.coverage
backend/**/htmlcov/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Database / SQLite (if any created locally)
*.sqlite
*.sqlite3
*.db